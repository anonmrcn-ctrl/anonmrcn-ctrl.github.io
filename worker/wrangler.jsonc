{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nnmrcn-rete",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://anonmrcn-ctrl.github.io"
  },
  "triggers": {
    "crons": ["17 2 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nnmrcn-rete",
      "database_id": "43916c45-c2d5-47da-95f8-3577f421821f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nnmrcn-media-eu",
      "jurisdiction": "eu"
    }
  ]
}
