{
  "version": 2,
  "compatibleContentSchema": 5,
  "limits": { "maxDepth": 8, "maxChildrenPerNode": 200 },
  "node": {
    "required": ["id", "type", "position", "content", "presentation", "behavior", "children"],
    "stableFields": ["id", "createdAt"],
    "revisionedFields": ["type", "position", "content", "presentation", "behavior", "children", "status"],
    "statuses": ["draft", "published", "archived"],
    "idPattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
  },
  "domains": {
    "content": { "editable": true },
    "presentation": { "editable": true },
    "behavior": { "editable": true },
    "technical": { "editable": false }
  },
  "propertySets": {
    "content.copy": { "domain": "content", "properties": ["eyebrow", "title", "text", "caption", "items"] },
    "content.media": { "domain": "content", "properties": ["assetId", "audioAssetId", "videoAssetId", "coverAssetId", "posterAssetId", "subtitleAssetId", "alt", "caption", "credit", "focalPoint", "transcript", "preload", "loop"] },
    "presentation.box": { "domain": "presentation", "properties": ["surface", "padding", "margin", "border", "radius", "shadow"] },
    "presentation.layout": { "domain": "presentation", "properties": ["width", "alignment", "gap", "columns", "order"] },
    "presentation.typography": { "domain": "presentation", "properties": ["style", "size", "weight", "lineHeight", "color"] },
    "presentation.responsive": { "domain": "presentation", "properties": ["phone", "tablet", "desktop", "visibility"] },
    "behavior.link": { "domain": "behavior", "properties": ["targetPageId", "href", "fragment", "anchorId", "openMode"] },
    "behavior.collection": { "domain": "behavior", "properties": ["source", "filters", "sort", "limit", "pagination", "display", "filterMode", "targetCollection", "externalService", "telemetry"] },
    "behavior.form": { "domain": "behavior", "properties": ["formType", "successMessage", "consentDocumentId", "consentMode", "externalService", "telemetry"] },
    "technical.binding": { "domain": "technical", "properties": ["table", "recordId", "r2Key", "adapter"] },
    "technical.security": { "domain": "technical", "properties": ["policy", "roles", "rateLimit", "csrf"] }
  },
  "categories": {
    "root": { "allowedChildren": ["structure", "content", "navigation", "project", "global", "functional", "personal", "legal"] },
    "structure": { "allowedChildren": ["structure", "content", "navigation", "project", "functional", "personal", "legal"] },
    "content": { "allowedChildren": [] },
    "navigation": { "allowedChildren": ["content", "navigation"] },
    "project": { "allowedChildren": ["structure", "content", "navigation", "functional"] },
    "global": { "allowedChildren": ["structure", "content", "navigation", "functional", "legal"] },
    "functional": { "allowedChildren": ["content", "functional"] },
    "personal": { "allowedChildren": ["structure", "content", "functional"] },
    "legal": { "allowedChildren": ["content", "navigation"] },
    "administration": { "allowedChildren": ["administration", "structure", "content", "navigation", "project", "functional", "legal"] }
  },
  "blockTypes": [
    { "id": "page-root", "category": "root", "propertySets": ["content.copy", "presentation.box", "presentation.layout", "presentation.responsive", "behavior.link"] },
    { "id": "section", "category": "structure", "propertySets": ["content.copy", "presentation.box", "presentation.layout", "presentation.responsive", "behavior.link"] },
    { "id": "container", "category": "structure", "propertySets": ["presentation.box", "presentation.layout", "presentation.responsive"] },
    { "id": "stack", "category": "structure", "propertySets": ["presentation.layout", "presentation.responsive"] },
    { "id": "row", "category": "structure", "propertySets": ["presentation.layout", "presentation.responsive"] },
    { "id": "columns", "category": "structure", "propertySets": ["presentation.layout", "presentation.responsive"] },
    { "id": "grid", "category": "structure", "propertySets": ["presentation.layout", "presentation.responsive"] },
    { "id": "separator", "category": "structure", "propertySets": ["presentation.box", "presentation.responsive"] },
    { "id": "spacer", "category": "structure", "propertySets": ["presentation.box", "presentation.responsive"] },
    { "id": "heading", "category": "content", "propertySets": ["content.copy", "presentation.box", "presentation.layout", "presentation.typography", "presentation.responsive", "behavior.link"] },
    { "id": "rich-text", "category": "content", "propertySets": ["content.copy", "presentation.typography", "presentation.responsive"] },
    { "id": "list", "category": "content", "propertySets": ["content.copy", "presentation.typography", "presentation.responsive"] },
    { "id": "quote", "category": "content", "propertySets": ["content.copy", "presentation.box", "presentation.typography", "presentation.responsive"] },
    { "id": "image", "category": "content", "propertySets": ["content.media", "presentation.box", "presentation.layout", "presentation.responsive", "behavior.link", "technical.binding"] },
    { "id": "gallery", "category": "content", "propertySets": ["content.media", "presentation.layout", "presentation.responsive", "technical.binding"] },
    { "id": "audio", "category": "content", "propertySets": ["content.copy", "content.media", "presentation.box", "presentation.layout", "presentation.responsive", "technical.binding"] },
    { "id": "video", "category": "content", "propertySets": ["content.copy", "content.media", "presentation.box", "presentation.layout", "presentation.responsive", "technical.binding"] },
    { "id": "button", "category": "content", "propertySets": ["content.copy", "presentation.box", "presentation.typography", "behavior.link"] },
    { "id": "link-list", "category": "navigation", "propertySets": ["content.copy", "presentation.layout", "behavior.link"] },
    { "id": "menu", "category": "navigation", "propertySets": ["content.copy", "presentation.layout", "presentation.responsive", "behavior.collection", "technical.binding"] },
    { "id": "table-of-contents", "category": "navigation", "propertySets": ["content.copy", "presentation.layout", "behavior.collection"] },
    { "id": "breadcrumb", "category": "navigation", "propertySets": ["content.copy", "presentation.layout", "behavior.collection"] },
    { "id": "global-header", "category": "global", "propertySets": ["content.copy", "content.media", "presentation.box", "presentation.layout", "presentation.responsive", "behavior.collection"] },
    { "id": "global-footer", "category": "global", "propertySets": ["content.copy", "presentation.box", "presentation.layout", "presentation.responsive", "behavior.collection"] },
    { "id": "global-notice", "category": "global", "propertySets": ["content.copy", "presentation.box", "presentation.responsive", "behavior.link"] },
    { "id": "project-poem", "category": "project", "propertySets": ["content.copy", "presentation.typography", "presentation.responsive", "technical.binding"] },
    { "id": "project-path", "category": "project", "propertySets": ["content.copy", "presentation.layout", "presentation.responsive", "behavior.collection", "technical.binding"] },
    { "id": "project-map", "category": "project", "propertySets": ["content.copy", "presentation.layout", "presentation.responsive", "behavior.collection", "technical.binding"] },
    { "id": "project-voices", "category": "project", "propertySets": ["content.copy", "content.media", "presentation.layout", "presentation.responsive", "behavior.collection", "technical.binding"] },
    { "id": "project-places", "category": "project", "propertySets": ["content.copy", "content.media", "presentation.layout", "presentation.responsive", "behavior.collection", "technical.binding"] },
    { "id": "project-sources", "category": "project", "propertySets": ["content.copy", "presentation.layout", "behavior.collection", "technical.binding"] },
    { "id": "project-memories", "category": "project", "propertySets": ["content.copy", "content.media", "presentation.layout", "presentation.responsive", "behavior.collection", "technical.binding"] },
    { "id": "project-archive", "category": "project", "propertySets": ["content.copy", "presentation.layout", "presentation.responsive", "behavior.collection", "technical.binding"] },
    { "id": "personal-notebook", "category": "personal", "propertySets": ["content.copy", "presentation.layout", "presentation.responsive", "behavior.collection", "technical.binding", "technical.security"] },
    { "id": "personal-space", "category": "personal", "propertySets": ["content.copy", "content.media", "presentation.layout", "presentation.responsive", "behavior.collection", "technical.binding", "technical.security"] },
    { "id": "special-access", "category": "functional", "propertySets": ["content.copy", "presentation.box", "behavior.form", "technical.binding", "technical.security"] },
    { "id": "legal-document", "category": "legal", "propertySets": ["content.copy", "presentation.typography", "presentation.responsive", "technical.binding"] },
    { "id": "approved-form", "category": "functional", "propertySets": ["content.copy", "presentation.box", "presentation.layout", "behavior.form", "technical.binding", "technical.security"] },
    { "id": "data-collection", "category": "functional", "propertySets": ["content.copy", "presentation.layout", "presentation.responsive", "behavior.collection", "technical.binding"] },
    { "id": "data-filter", "category": "functional", "propertySets": ["content.copy", "presentation.layout", "behavior.collection", "technical.binding"] },
    { "id": "admin-workspace", "category": "administration", "propertySets": ["content.copy", "presentation.layout", "presentation.responsive", "technical.security"] },
    { "id": "admin-tool-panel", "category": "administration", "propertySets": ["content.copy", "presentation.box", "presentation.layout", "presentation.responsive", "technical.binding", "technical.security"] }
  ],
  "compatibility": {
    "preserve": [
      "URL pubblico, permalink e alias storici",
      "QR e query compatibili",
      "ID di frammento e ancore della poesia",
      "ID D1 e revisioni append-only",
      "chiavi R2, checksum e varianti media",
      "canonical, robots e inclusione sitemap",
      "binding data-cms-block esistenti",
      "ripiego statico finché il renderer non è verificato"
    ],
    "unknownTypePolicy": "reject-write-and-render-static-fallback",
    "unknownPropertyPolicy": "reject-write-and-ignore-on-compatible-read"
  },
  "forbiddenEditorInputs": ["html", "css", "javascript", "sql", "endpoint", "secret", "token"]
}
